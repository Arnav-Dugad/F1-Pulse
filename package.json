{
  "name": "f1-pulse",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "verify:accuracy": "node scripts/verify-accuracy.mjs",
    "media:fetch": "python scripts/fetch-media.py && python scripts/process-media.py",
    "data:history": "node scripts/fetch-history.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.149.0"
  }
}
