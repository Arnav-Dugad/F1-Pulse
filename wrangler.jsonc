{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-pulse",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*"]
  },
  "observability": { "enabled": true }
}
