{
  "id": "/",
  "name": "F1 Pulse — Feel every lap",
  "short_name": "F1 Pulse",
  "description": "The independent Formula 1 companion: results, standings, driver and team profiles, telemetry and more.",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#040406",
  "theme_color": "#040406",
  "lang": "en",
  "dir": "ltr",
  "categories": ["sports", "news"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Standings", "url": "/#/standings", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "/#/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Drivers", "url": "/#/drivers", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
