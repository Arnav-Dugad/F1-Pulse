{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-pulse",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/drivers.html",
      "/teams.html",
      "/schedule.html",
      "/about.html",
      "/driver-profile.html",
      "/team-profile.html",
      "/race-detail.html",
    ],
  },
  "observability": { "enabled": true },
  // Pre-warms current-season endpoints and runs the points self-check (worker `scheduled()`).
  // Every 15 minutes: keeps the saved current-season copy (served to readers while < 20 min old) fresh.
  // ≈ 96 runs/day ≈ 200 KV writes and ≈ 1,000 Jolpica requests — well inside both limits.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Exposed by GET /api/status as the build id.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // Origin used for scheduled pre-warm requests (edge cache keys are per hostname).
    "PULSE_ORIGIN": "https://f1-pulse.arnavrival12.workers.dev",
  },
  // Optional (recommended): persist the latest /api/status report, a last-known-good current season and
  // completed seasons for /api/season globally (the Cache API is a no-op on *.workers.dev).
  // Holds the scheduled self-check report and completed-season bundles (created with `wrangler kv namespace create PULSE_KV`).
  "kv_namespaces": [{ "binding": "PULSE_KV", "id": "963ef4316cac47d1ab625953c780fe43" }],
  //
  // Optional: privacy-friendly page views (POST /api/hit). Requires Workers Analytics Engine on the
  // account (dashboard → Workers & Pages → Analytics Engine); the dataset is created on first write.
  // Enable Analytics Engine once in the dashboard (Workers & Pages → Analytics Engine), then uncomment:
  // "analytics_engine_datasets": [{ "binding": "PULSE_ANALYTICS", "dataset": "f1_pulse_pageviews" }],
}
