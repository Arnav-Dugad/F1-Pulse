{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f1-pulse",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
}
